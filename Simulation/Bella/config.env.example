# Bella environment configuration — copy to .env and fill in real values.
# NEVER commit real keys to git.

# Materials Project API key (required for MP and validation bandgaps)
MATERIALS_PROJECT_API_KEY=your_key_here

# Catalysis Hub GraphQL endpoint (URL only, no API key required)
CATALYSIS_HUB_URL=https://api.catalysis-hub.org/graphql

# NIST Chemistry WebBook endpoint (URL only, no API key required)
NIST_WEBBOOK_URL=https://webbook.nist.gov/cgi/cbook.cgi

# Astro pipeline (optional)
# BELLA_MAST_TOKEN=        # raises MAST rate limits, get from https://auth.mast.stsci.edu
# BELLA_ASTRO_TIMEOUT=30   # seconds per archive call (increase for overnight runs)

# BL / SETI dataset (optional)
# BELLA_BL_DATASET_PATH=/home/lumiere/datasets/bl_hits_692stars.csv
# Override BL dataset location (default: ~/.bella/astro_cache/catalogs/)
